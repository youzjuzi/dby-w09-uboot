+struct dby_sd_stats {
+	u64 bytes, read_ms, sha_ms, init_ms;
+};
+static inline bool dby_dma64_supported(u32 caps)
+{
+	const u32 required = SDHCI_CAN_DO_ADMA2 | SDHCI_CAN_64BIT;
+
+	return (caps & required) == required;
+}
+static int dby_format_bootargs(char *buf, size_t capacity,
+			  const struct dby_sd_stats *stats)
+{
+	const char *dma = CONFIG_IS_ENABLED(MMC_SDHCI_ADMA) ? "adma64" : "pio";
+	int n;
+
+	n = snprintf(buf, capacity, DBY_LINUX_ARGS
+		     " dby.sd_bytes=%llu dby.sd_read_ms=%llu dby.sd_sha_ms=%llu"
+		     " dby.sd_init_ms=%llu dby.sd_dma=%s",
+		     (unsigned long long)stats->bytes,
+		     (unsigned long long)stats->read_ms,
+		     (unsigned long long)stats->sha_ms,
+		     (unsigned long long)stats->init_ms, dma);
+	return n < 0 || (size_t)n >= capacity ? -E2BIG : 0;
+}
+static u64 dby_sd_init_ms;
