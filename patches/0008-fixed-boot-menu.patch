@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Fixed, RAM-only menu policy; no path returns to the command prompt. */
+#include <command.h>
+#include <console.h>
+#include <diagnostic.h>
+#include <env.h>
+#include <hang.h>
+#include <version.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+
+int dby_clear_misc(void);
+static bool entered;
+static int misc_status = -EPERM;
+enum dby_action { DBY_UBUNTU, DBY_REBOOT, DBY_OFF };
+static enum dby_action selected = DBY_UBUNTU;
+
+int dby_boot_misc_status(void)
+{
+	return misc_status;
+}
+
+static void __noreturn dby_ubuntu(void)
+{
+	clear_ctrlc();
+	run_command("sdread", 0);
+	/* Failed SD boot already counted down; even a failed reset cannot open CLI. */
+	exp_diag_flush();
+	hang();
+}
+
+static int do_dbyselect(struct cmd_tbl *cmdtp, int flag, int argc,
+			char *const argv[])
+{
+	if (argc != 2)
+		return CMD_RET_USAGE;
+	if (!strcmp(argv[1], "ubuntu"))
+		selected = DBY_UBUNTU;
+	else if (!strcmp(argv[1], "reboot"))
+		selected = DBY_REBOOT;
+	else if (!strcmp(argv[1], "off"))
+		selected = DBY_OFF;
+	else
+		return CMD_RET_USAGE;
+	return CMD_RET_SUCCESS;
+}
+
+static int do_dbyboot(struct cmd_tbl *cmdtp, int flag, int argc,
+		      char *const argv[])
+{
+	int ret;
+
+	if (entered)
+		dby_ubuntu();
+	entered = true;
+	console_assign(stdout, "vidconsole");
+	console_assign(stderr, "vidconsole");
+	puts("\x1b[0;1;37;40m");
+	console_clear();
+	puts("DBY-W09 SD LINUX BOOT " PLAIN_VERSION "\n");
+	misc_status = dby_clear_misc();
+	exp_diag_flush();
+	if (misc_status)
+		dby_ubuntu();
+	ret = console_assign(stdin, "button-kbd");
+	if (ret) {
+		printf("button-kbd rc=%d; starting Ubuntu\n", ret);
+		exp_diag_flush();
+		dby_ubuntu();
+	}
+	ret = env_set("bootmenu_0", "Ubuntu=dbyselect ubuntu");
+	ret |= env_set("bootmenu_1", "Reboot to HarmonyOS=dbyselect reboot");
+	ret |= env_set("bootmenu_2", "Power off=dbyselect off");
+	ret |= env_set("bootmenu_3", NULL);
+	ret |= env_set("bootmenu_default", "0");
+	ret |= env_set("bootmenu_delay", "5");
+	if (ret) {
+		printf("menu environment rc=%d; starting Ubuntu\n", ret);
+		exp_diag_flush();
+		dby_ubuntu();
+	}
+	selected = DBY_UBUNTU;
+	clear_ctrlc();
+	ret = run_command("bootmenu", 0);
+	clear_ctrlc();
+	if (ret)
+		selected = DBY_UBUNTU;
+	if (selected == DBY_REBOOT || selected == DBY_OFF) {
+		const char *command = selected == DBY_REBOOT ? "reset" : "poweroff";
+
+		printf("%s via PSCI\n", command);
+		exp_diag_flush();
+		ret = run_command(command, 0);
+		printf("%s returned rc=%d; starting Ubuntu\n", command, ret);
+		exp_diag_flush();
+		mdelay(1000);
+	}
+	dby_ubuntu();
+}
+
+U_BOOT_CMD(dbyboot, 1, 0, do_dbyboot, "fixed offline boot policy", "");
+U_BOOT_CMD(dbyselect, 2, 0, do_dbyselect, "select a fixed boot action", "ubuntu|reboot|off");
