--- /dev/null
+++ b/drivers/button/button-dby-pmic-gpio.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* DBY-W09 volume-up: observe the inherited PMIC GPIO configuration only. */
+#include <button.h>
+#include <dm.h>
+#include <power/pmic.h>
+#include <linux/errno.h>
+#include <dt-bindings/input/linux-event-codes.h>
+
+struct dby_pmic_gpio_priv {
+	u32 base;
+};
+
+static int dby_pmic_gpio_bind(struct udevice *dev)
+{
+	struct button_uc_plat *plat = dev_get_uclass_plat(dev);
+
+	plat->label = dev_read_string(dev, "label");
+	return plat->label ? 0 : -EINVAL;
+}
+
+static int dby_pmic_gpio_probe(struct udevice *dev)
+{
+	static const unsigned int offsets[] = { 4, 5, 0x40, 0x41, 0x42, 0x46 };
+	static const int expected[] = { 0x10, 0x11, 0, 0, 0, 0x80 };
+	struct dby_pmic_gpio_priv *priv = dev_get_priv(dev);
+	unsigned int i;
+	int value;
+
+	if (dev_read_addr(dev) != 0xc500 ||
+	    dev_read_u32_default(dev, "linux,code", 0) != KEY_VOLUMEUP)
+		return -EINVAL;
+	priv->base = 0xc500;
+	for (i = 0; i < ARRAY_SIZE(offsets); i++) {
+		value = pmic_reg_read(dev->parent, priv->base + offsets[i]);
+		if (value < 0)
+			return value;
+		if (value != expected[i])
+			return -ENXIO;
+	}
+	return 0;
+}
+
+static enum button_state_t dby_pmic_gpio_get_state(struct udevice *dev)
+{
+	struct dby_pmic_gpio_priv *priv = dev_get_priv(dev);
+	int value = pmic_reg_read(dev->parent, priv->base + 8);
+
+	if (value < 0)
+		return value;
+	if (!(value & 0x80))
+		return -EIO;
+	return value & 1 ? BUTTON_OFF : BUTTON_ON;
+}
+
+static int dby_pmic_gpio_get_code(struct udevice *dev)
+{
+	return KEY_UP;
+}
+
+static const struct button_ops dby_pmic_gpio_ops = {
+	.get_state = dby_pmic_gpio_get_state,
+	.get_code = dby_pmic_gpio_get_code,
+};
+
+static const struct udevice_id dby_pmic_gpio_ids[] = {
+	{ .compatible = "huawei,dby-w09-pmic-gpio-button" },
+	{ }
+};
+
+U_BOOT_DRIVER(dby_pmic_gpio_button) = {
+	.name = "dby_pmic_gpio_button",
+	.id = UCLASS_BUTTON,
+	.of_match = dby_pmic_gpio_ids,
+	.bind = dby_pmic_gpio_bind,
+	.probe = dby_pmic_gpio_probe,
+	.ops = &dby_pmic_gpio_ops,
+	.priv_auto = sizeof(struct dby_pmic_gpio_priv),
+};
